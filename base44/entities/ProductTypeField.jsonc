{
  "name": "ProductTypeField",
  "type": "object",
  "properties": {
    "product_type_code": {
      "type": "string",
      "description": "Code of the product type this field belongs to"
    },
    "field_name": {
      "type": "string",
      "description": "Name of the field (e.g., movement_type)"
    },
    "field_label": {
      "type": "string",
      "description": "Display label for the field"
    },
    "field_type": {
      "type": "string",
      "enum": [
        "text",
        "number",
        "currency",
        "select",
        "checkbox",
        "textarea"
      ],
      "description": "Type of input field"
    },
    "options": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Options for select fields"
    },
    "required": {
      "type": "boolean",
      "default": false,
      "description": "Whether this field is required"
    },
    "order": {
      "type": "number",
      "default": 0,
      "description": "Display order of the field"
    }
  },
  "required": [
    "product_type_code",
    "field_name",
    "field_label",
    "field_type"
  ],
  "rls": {
    "read": true,
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
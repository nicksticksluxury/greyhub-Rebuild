{
  "name": "SourceOrder",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "ID of the company that owns this order"
    },
    "source_id": {
      "type": "string",
      "description": "ID of the WatchSource"
    },
    "order_number": {
      "type": "string",
      "description": "Order number for this shipment (e.g., 001, 002)"
    },
    "date_received": {
      "type": "string",
      "format": "date",
      "description": "Date the shipment was received"
    },
    "total_cost": {
      "type": "number",
      "description": "Total cost for this shipment/order"
    },
    "initial_quantity": {
      "type": "number",
      "description": "Initial quantity of watches received in this shipment"
    },
    "notes": {
      "type": "string",
      "description": "Order-specific notes"
    }
  },
  "required": [
    "source_id",
    "order_number",
    "company_id"
  ],
  "rls": {
    "create": {
      "data.company_id": "{{user.data.company_id}}"
    },
    "read": {
      "data.company_id": "{{user.data.company_id}}"
    },
    "update": {
      "data.company_id": "{{user.data.company_id}}"
    },
    "delete": {
      "data.company_id": "{{user.data.company_id}}"
    }
  }
}